[Unit]
Description=ONE personal AI workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=theone
Group=theone
WorkingDirectory=/srv/theone/current
EnvironmentFile=/srv/theone/shared/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Keep ONE isolated from the other projects on this server.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/theone/shared
UMask=0077
MemoryMax=1G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
