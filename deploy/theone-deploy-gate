#!/usr/bin/env bash
set -euo pipefail

# Forced command for the GitHub Actions key: no interactive shell is allowed.
if [[ "${SSH_ORIGINAL_COMMAND:-}" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  exec sudo -n /usr/local/sbin/theone-deploy "${BASH_REMATCH[1]}"
fi

echo "Denied: this SSH key may only deploy ONE." >&2
exit 126
