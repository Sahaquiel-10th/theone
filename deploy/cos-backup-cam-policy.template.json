{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "name/cos:HeadBucket",
        "name/cos:GetBucket",
        "name/cos:ListMultipartUploads"
      ],
      "resource": [
        "qcs::cos:ap-nanjing:uid/APPID:BUCKET-NAME-WITH-APPID/"
      ]
    },
    {
      "effect": "allow",
      "action": [
        "name/cos:PutObject",
        "name/cos:HeadObject",
        "name/cos:InitiateMultipartUpload",
        "name/cos:UploadPart",
        "name/cos:CompleteMultipartUpload",
        "name/cos:AbortMultipartUpload",
        "name/cos:ListParts"
      ],
      "resource": [
        "qcs::cos:ap-nanjing:uid/APPID:BUCKET-NAME-WITH-APPID/production/mysql/*"
      ]
    }
  ]
}
