NODE_ENV=production
HOST=127.0.0.1
PORT=3091
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
APP_ORIGIN=https://theone.aiarrival.cn

# 得到大脑开放平台。每位租户通过设备授权连接自己的账号。
GETNOTE_CLIENT_ID=
GETNOTE_TEST_CONNECT_ENABLED=false
GETNOTE_TEST_API_KEY=
GETNOTE_API_URL=https://openapi.biji.com
GETNOTE_API_TIMEOUT_MS=15000
# Notion 官方 MCP 默认支持动态客户端注册；已有固定 OAuth 客户端时可选填。
NOTION_MCP_CLIENT_ID=
NOTION_MCP_CLIENT_SECRET=
# 生产环境必填，至少 32 个字符，用于加密保存租户知识平台凭据。
PROVIDER_CREDENTIALS_KEY=

MODEL_REQUEST_TIMEOUT_MS=150000
IMAGE_REQUEST_TIMEOUT_MS=180000
MODEL_MAX_OUTPUT_TOKENS=3000
CHAT_HISTORY_MESSAGES=12
YYLX_API_KEY=

# 联网搜索
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000

ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_EXTRACTED_CHARS=30000
ATTACHMENT_CONTEXT_CHARS=24000

# 本地开发默认 JSON；生产环境可切换 MySQL。
DB_PROVIDER=json
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=one_app
MYSQL_PASSWORD=
MYSQL_DATABASE=theone_prod
MYSQL_CONNECTION_LIMIT=10
MYSQL_AUTO_MIGRATE=false
